{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionmirror.dev/schemas/generation-settings.v1.schema.json",
  "title": "GenerationSettingsV1",
  "description": "Generation settings validated in both Java and Python. Cross-field rules live in code and are pinned by the shared fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed", "height", "width", "num_inference_steps", "guidance_scale", "segment_frame_length", "prev_segment_conditioning_frames"],
  "properties": {
    "schema_version": {"const": 1},
    "positive_prompt": {"type": "string", "maxLength": 2000},
    "negative_prompt": {"type": "string", "maxLength": 2000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "height": {"type": "integer", "minimum": 16, "maximum": 1280},
    "width": {"type": "integer", "minimum": 16, "maximum": 1280},
    "num_inference_steps": {"type": "integer", "minimum": 1, "maximum": 100},
    "guidance_scale": {"type": "number", "minimum": 1, "maximum": 20},
    "segment_frame_length": {"type": "integer", "minimum": 5, "maximum": 121},
    "prev_segment_conditioning_frames": {"type": "integer", "minimum": 1, "maximum": 21},
    "processing_fps": {"type": "integer", "minimum": 1, "maximum": 60},
    "mask_expand_pixels": {"type": "integer", "minimum": 0, "maximum": 128},
    "mask_feather_pixels": {"type": "integer", "minimum": 0, "maximum": 64},
    "retain_audio": {"type": "boolean"}
  }
}
