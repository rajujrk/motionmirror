# CUDA worker image for real preprocessing and generation. Built from the repository root for linux/amd64.
# It holds no weights: they are mounted read-only at /models, and the hub is kept offline at run time so a missing
# file is a clear MODEL_MISSING failure rather than a surprise download. Not yet run on a GPU: pending GPU validation.
FROM python:3.12-slim-bookworm AS build
RUN pip install --no-cache-dir uv==0.13.7
WORKDIR /app/services/ml-worker
COPY services/ml-worker/pyproject.toml services/ml-worker/uv.lock ./
COPY services/ml-worker/src ./src
RUN uv sync --frozen --no-dev --no-editable --extra wan --extra preprocess

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 worker
COPY --from=build /app/services/ml-worker/.venv /app/services/ml-worker/.venv
COPY packages/contracts /app/contracts
COPY configs/presets /app/configs/presets
COPY configs/models /app/configs/models
ENV PATH=/app/services/ml-worker/.venv/bin:$PATH \
    MM_CONTRACTS_DIR=/app/contracts \
    MM_PRESETS_DIR=/app/configs/presets \
    MM_MODELS_CONFIG=/app/configs/models/wan-animate-14b.yaml \
    MM_MODEL_CACHE=/models \
    MM_SCRATCH_DIR=/tmp/motionmirror-attempts \
    HF_HOME=/tmp/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
USER worker
ENTRYPOINT ["python", "-m", "motionmirror.worker"]
