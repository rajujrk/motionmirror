# Local development settings. `make bootstrap` copies this to .env and replaces every __GENERATE__ with a
# random secret. .env is git-ignored. Production uses a secret manager, see docs/runbooks/CLOUD_GPU_DEPLOYMENT.md.

COMPOSE_PROJECT_NAME=motionmirror
# Set by bootstrap to match this host, so no service runs under emulation.
MM_PLATFORM=linux/arm64
# local or production. Production refuses mock mode and insecure defaults at startup.
MM_DEPLOYMENT=local
# Origin the browser uses. It must match the Keycloak redirect URI.
MM_PUBLIC_ORIGIN=http://localhost:8088
# Host ports, all bound to loopback. They avoid the defaults so a native PostgreSQL, Redis or RabbitMQ
# on this machine can't be reached by mistake. Change them here if `make doctor` reports a conflict.
MM_HTTP_PORT=8088
MM_HOST_POSTGRES_PORT=55432
MM_HOST_RABBIT_PORT=55672
MM_HOST_RABBIT_MGMT_PORT=55673
MM_HOST_REDIS_PORT=56379
MM_HOST_S3_PORT=58333
# Storage endpoint as the browser sees it. Signed URLs must be valid from the requester's network.
MM_S3_PUBLIC_ENDPOINT=http://localhost:58333

POSTGRES_PASSWORD=__GENERATE__
MM_DB_PASSWORD=__GENERATE__
MM_KEYCLOAK_DB_PASSWORD=__GENERATE__

# Keycloak bootstrap admin and OIDC clients.
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__
MM_WEB_CLIENT_SECRET=__GENERATE__
MM_WORKER_MOCK_CLIENT_SECRET=__GENERATE__
MM_WORKER_WAN_CLIENT_SECRET=__GENERATE__
# Local test users, created in the realm: dev.user@motionmirror.test and dev.admin@motionmirror.test.
MM_DEV_USER_PASSWORD=__GENERATE__
MM_DEV_ADMIN_PASSWORD=__GENERATE__

# RabbitMQ identities. Provisioning, publishing, consuming and monitoring are separate on purpose.
MM_RABBIT_PROVISION_PASSWORD=__GENERATE__
MM_RABBIT_PUBLISHER_PASSWORD=__GENERATE__
MM_RABBIT_CONSUMER_MOCK_PASSWORD=__GENERATE__
MM_RABBIT_CONSUMER_WAN_PASSWORD=__GENERATE__
MM_RABBIT_MONITOR_PASSWORD=__GENERATE__
# Must exceed the longest attempt plus a cleanup margin (6 hours by default).
MM_RABBIT_CONSUMER_TIMEOUT_MS=21600000

MM_REDIS_PASSWORD=__GENERATE__

MM_S3_ACCESS_KEY=__GENERATE__
MM_S3_SECRET_KEY=__GENERATE__
MM_S3_BUCKET=motionmirror-media

# Upload and job limits.
MM_MAX_SOURCE_BYTES=524288000
MM_MAX_SOURCE_SECONDS=30
MM_MAX_REFERENCE_BYTES=26214400
MM_MAX_ACTIVE_JOBS_PER_USER=2
