# Environment for the Runpod GPU Pod. Put these in the Pod's encrypted secrets, never in an image or this repository.
# Every value is a placeholder until you create the matching service. See docs/runbooks/CLOUD_GPU_DEPLOYMENT.md.
MM_WORKER_ID=runpod-1
MM_BACKEND=wan-animate
MM_DEVICE_PROFILE=cuda
MM_WAN_DTYPE=bfloat16
MM_WAN_OFFLOAD=model
MM_API_BASE_URL=https://${MM_WORKER_DOMAIN}
MM_OIDC_TOKEN_URL=https://${MM_WORKER_DOMAIN}/auth/realms/motionmirror/protocol/openid-connect/token
MM_OIDC_CLIENT_ID=motionmirror-worker-wan
MM_OIDC_CLIENT_SECRET=${MM_WORKER_WAN_CLIENT_SECRET}
MM_AMQP_URL=amqps://mm-consumer-wan:${MM_RABBIT_CONSUMER_WAN_PASSWORD}@${MM_RABBIT_HOST}:5671/motionmirror
MM_QUEUES=motionmirror.preprocess.v1,motionmirror.generate.wan-animate.v1
# On the network volume, so weights survive the Pod being terminated.
MM_MODEL_CACHE=/workspace/models
# On the container disk, so attempts leave nothing behind when the Pod stops.
MM_SCRATCH_DIR=/tmp/motionmirror-attempts
